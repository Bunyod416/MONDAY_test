# Admin panel paroli (SHA-256 hash, "EXAM_ADMIN_v1::" prefiksi bilan).
# Yangi hash olish:
#   node -e "console.log(require('crypto').createHash('sha256').update('EXAM_ADMIN_v1::YANGIPAROL').digest('hex'))"
VITE_ADMIN_PASSWORD_HASH=

# Natija faylini shifrlash va imzolash kaliti.
# Har imtihon uchun yangisini qo'ying — shunda oldingi imtihondan
# kalitni bilib olgan talabaning fayli qabul qilinmaydi.
VITE_EXAM_SECRET=
